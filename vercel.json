{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/homepagetest", "destination": "/homepagetest.html" },
    { "source": "/homepagetest1", "destination": "/homepagetest1.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/editor", "destination": "/editor/index.html" },
    { "source": "/sites/:path*", "destination": "/sites/index.html" },
    { "source": "/email/:path*", "destination": "/email/index.html" }
  ]
}
