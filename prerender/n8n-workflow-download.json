        "jsCode": "// Customer config: comes from the 'Customer Config' node — swap that node\n// for your real purchase-flow input later, keeping the same node name (or\n// update the reference below).\nconst config = $('Customer Config').first().json;\n\n// GitHub file:get (asBinaryProperty=false) returns base64 in json.content\nconst file = (name) => Buffer.from($(name).first().json.content, 'base64').toString('utf8');\nconst bundleJs = file('Get Bundle');\nconst cssText = file('Get CSS');\nconst siteJs = file('Get SiteJS');\n\n/* >>> PASTE the entire contents of prerender/fuse.cjs BELOW this line,\n       then DELETE its final `module.exports = { fuseSite };` line <<< */\n\n\n\n/* >>> END PASTE <<< */\n\nconst result = await fuseSite({ config, bundleJs, cssText, siteJs, domain: config.domain });\n\nreturn [\n  ...result.files.map((f) => ({ json: { type: 'file', path: f.path, content: f.content } })),\n  ...result.copies.map((c) => ({ json: { type: 'image', from: c.from, to: c.to } })),\n  { json: { type: 'meta', slug: result.slug, domain: result.domain, warnings: result.warnings, routes: result.routes } },\n];"
